PORT=3000
HOST=127.0.0.1
PUBLIC_BASE_URL=http://localhost:3000
IMWEB_CLIENT_ID=
IMWEB_CLIENT_SECRET=
IMWEB_SITE_CODE=
# npm run setup generates these locally. Never copy secrets into chat.
ADMIN_PASSWORD=
TOKEN_ENCRYPTION_KEY=
MCP_CLIENT_ID=cosa-chatgpt
MCP_CLIENT_SECRET=
# Exact callback URL displayed by ChatGPT when creating the app.
MCP_REDIRECT_URIS=
TOKEN_FILE=.data/imweb-tokens.enc
# Set to 1 only behind one trusted reverse proxy; otherwise leave 0.
TRUST_PROXY_HOPS=0
